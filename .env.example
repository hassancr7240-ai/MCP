# Azure AD
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Azure Key Vault
KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# Azure Blob Storage
BLOB_ACCOUNT_URL=https://youraccount.blob.core.windows.net
BLOB_CONTAINER_NAME=pm-documents

# Azure SQL Database
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=pm-history
SQL_USERNAME=pm-app-user
SQL_PASSWORD=your-db-password

# AI Models
OPENAI_API_KEY=your-openai-key
OPENAI_API_BASE=https://your-aoai.openai.azure.com/
OPENAI_DEPLOYMENT=gpt-4o
GEMINI_API_KEY=your-gemini-key
LLAMA_BASE_URL=http://internal-llama:8080/v1

# Azure App Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key

# App Settings
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://your-dashboard.azurewebsites.net
JWT_AUDIENCE=api://your-client-id
MAX_RETRIES=3
